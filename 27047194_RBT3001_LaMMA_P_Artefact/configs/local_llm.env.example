# Copy these values into your shell or a private .env file when using local models.
# Ollama OpenAI-compatible endpoint:
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=local-no-key-required
LOCAL_LLM_MODEL=llama3.1:8b

# Open WebUI is also OpenAI-compatible when configured with an API token.
# Typical examples are:
# LOCAL_LLM_BASE_URL=http://localhost:3000/api
# LOCAL_LLM_BASE_URL=http://localhost:8080/api
# LOCAL_LLM_API_KEY=<your-open-webui-token-if-required>
